<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%!  
		int[] winNums = {3, 12, 19, 27, 33, 41};
		int find =0;
	 	public boolean isWinning(int num){
	 		boolean result = false;
	 		for(int i=0; i<winNums.length; i++){
	 			if(num==winNums[i]){
	 				result = true;
	 			}
	 		}
	 		return result;
	 	}	
	%>
	<table border="1">
		<tr>
		<%for(int i=1; i<=45; i++){%>
			<td style="background-color:<%=isWinning(i)?"gold; font-weight:bold;":"white; "%>"><%= i %></td>
			<%if(i%9==0){%>
				</tr>
			<%}%>		
		<%}%>
		<%for(int i=0; i<winNums.length; i++){ %>
			<%= find = winNums[i]%>
		<%} %>
		<p>당첨번호:<%=find%></p>
	</table>
</body>
</html>