<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
<!-- 구구단 2단~ 9단까지 모두 출력할 것 -->

<table border="1">
<%for(int i=1; i<10; i++) {%>
	<th><% i+1 %>단</th>
	<tr>
	<%for(int j=2; j<10; j++){%>
	<td><%=j%>x<%=i%>=<%=j*i%><td/>
	<%}%>
	<tr/>
<%}%>
</table>
</body>
</html>