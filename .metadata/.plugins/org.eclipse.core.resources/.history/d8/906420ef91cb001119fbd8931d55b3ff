<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%
		request.setCharacterEncoding("utf-8");
	
		String id = request.getParameter("id");
		String pass = request.getParameter("pass");
		String passchk = request.getParameter("passchk");
		String email = request.getParameter("email");
		String tel = request.getParameter("tel");
		String hobby[] = request.getParameterValues("hobby");
		String job = request.getParameter("job");
		String age = request.getParameter("age");
		String info = request.getParameter("info");
	%>
	<%if(!pass.equals(passchk)){%>
	<!--
		자바스크립트 객체종류
		1. 코어 객체
		2. DOM 객체
		3. BOM 객체 ==> 브라우저에서 사용하는 객체
		
			history객체는 브라우저가 현재 탭이나 창에서 방문했던 웹페이지들의
			기록을 관리하고 제어하는 객체이다.
			
			* history 객체의 메소드 종류
			 -history.back() : 바로 이전 페이지로 이동(뒤로가기)
			 -history.forward() : 바로 다음 페이지로 이동(뒤로가기)
			 -history.go(n) : 지정한 상대적 위치만큼 이동
			  - history.go(1) 은 앞으로 1페이지 가기
			  - history.go(0) 은 현재페이지
			  - history.go(-1) 은 뒤로 1페이지 가기
	  -->
		<script type="text/javascript">
			alert("비밀번호가 틀립니다.");
			history.go(-1);
		</script>
	<%} %>
	<table border="1">
		<tr>
			<td>아이디 : <%= id%></td>
		</tr>
		<tr>
			<td>비밀번호 : <%= pass%></td>
		</tr>
		<tr>
			<td>비밀번호 확인 : <%= passchk%></td>
		</tr>
		<tr>
			<td>이메일 : <%= email%></td>
		</tr>
		<tr>
			<td>전화번호 : <%= tel%></td>
		</tr>
		<tr>
			<td>관심분야 : 
			<% for(int i=0; i<hobby.length; i++){%>
					<%if(i+1==hobby.length){%>
						<%= hobby[i]%>
					<%}else{%>
						<%= hobby[i]%>,
					<%}%>
			<%} %>
			</td>
		</tr>
		<tr>
			<td>직업 : <%= job%></td>
		</tr>
		<tr>
			<td>연령 : <%= age%></td>
		</tr>
		<tr>
			<td>남기는 말 : <%= info%></td>
		</tr>
	</table>
</body>
</html>