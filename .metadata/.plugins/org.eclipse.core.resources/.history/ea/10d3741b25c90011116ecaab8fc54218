<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%!
		String[] names = {"김철수", "이영희", "박민수", "최지우", "정다은"}; 
		int[] scores = {92, 78, 55, 85, 67};
		
		 public char getGrade(int score){
			 char result;
			 if(score>=90){
				 result = 'A';
			 }else if(score>=80){
				 result = 'B';
			 }else if(score>=70){
				 result = 'C';
			 }else if(score>=60){
				 result = 'D';
			 }else{
				 result = 'F';
			 }
			 return result;
		 };
	%>
	<table border="1">
	<tr>
	<th>번호</th><th>이름</th><th>점수</th><th>등급</th><th>그래프</th>
	</tr>
	<% for(int i=0; i<names.length; i++) {%>
		<tr style="background-color:<%=scores[i]<=60? "#ffcccc;":"white"%>;">
			<td><%=i+1%></td>
			<td><%= names[i] %></td>
			<td><%=scores[i]%></td>
			<td><%= getGrade(scores[i]) %></td>
			<td><div style="width:<%=scores[i]*3%>px; background-color:lightblue; height:20px;"></div></td>
			</tr>
	<%} %>
	</table>
</body>
</html>