<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<%! 
		public boolean third(int num01){
			boolean result;
			if(num01%3==0){
				result = true;
			}else{
				result = false;
			}
			return result;
		}
		public boolean second(int num02){
			boolean result;
			if(num02%2==0){
				result = true;
			}else{
				result = false;
			}
			return result;
		}
	%>
	
	<table>
		<tr>
			<th>숫자</th><th>제곱</th><th>구분</th>
		</tr>	
	<%for(int i=1; i<=20; i++){%>
		<tr>
			<td>i</td>
			<td>i*i</td>
			<td><%= second((i*i)) %></td>
		</tr>
	<%} %>
	
	
	</table>
</body>
</html>